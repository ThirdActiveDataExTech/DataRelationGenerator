@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix kv: <http://example.org/keyvalue#> .

# 온톨로지 메타데이터
<http://example.org/keyvalue> a owl:Ontology ;
    rdfs:label "Key-Value Graph Ontology"@ko ;
    rdfs:comment "액티브 메타데이터 기반 Key-Value 그래프 온톨로지"@ko ;
    owl:versionInfo "1.0" .

# 클래스 정의
kv:Document a owl:Class ;
    rdfs:label "문서"@ko ;
    rdfs:comment "원본 데이터 레코드"@ko .

kv:Key a owl:Class ;
    rdfs:label "키"@ko ;
    rdfs:comment "데이터 필드명 (한글)"@ko .

kv:Value a owl:Class ;
    rdfs:label "값"@ko ;
    rdfs:comment "필드의 실제 값"@ko .

kv:NormalizedValue a owl:Class ;
    rdfs:label "정규화된 값"@ko ;
    rdfs:comment "정규화된 대표 값"@ko .

# Object Property 정의
kv:hasKey a owl:ObjectProperty ;
    rdfs:label "키 보유"@ko ;
    rdfs:domain kv:Document ;
    rdfs:range kv:Key ;
    rdfs:comment "문서가 특정 속성(키)을 가짐"@ko .

kv:hasValue a owl:ObjectProperty ;
    rdfs:label "값 보유"@ko ;
    rdfs:domain kv:Key ;
    rdfs:range kv:Value ;
    rdfs:comment "키가 특정 값을 가짐"@ko .

kv:extractedFrom a owl:ObjectProperty ;
    rdfs:label "추출 출처"@ko ;
    rdfs:domain kv:Value ;
    rdfs:range kv:Document ;
    rdfs:comment "값이 특정 문서에서 추출됨"@ko ;
    owl:inverseOf kv:hasExtractedValue .

kv:hasExtractedValue a owl:ObjectProperty ;
    rdfs:label "추출된 값"@ko ;
    rdfs:domain kv:Document ;
    rdfs:range kv:Value ;
    owl:inverseOf kv:extractedFrom .

kv:sameAs a owl:ObjectProperty ;
    rdfs:label "동일"@ko ;
    rdfs:domain kv:Value ;
    rdfs:range kv:NormalizedValue ;
    rdfs:comment "값이 정규화된 대표 값과 동일함"@ko .

# Datatype Property 정의
kv:documentId a owl:DatatypeProperty ;
    rdfs:label "문서 ID"@ko ;
    rdfs:domain kv:Document ;
    rdfs:range xsd:string .

kv:keyName a owl:DatatypeProperty ;
    rdfs:label "키 이름"@ko ;
    rdfs:domain kv:Key ;
    rdfs:range xsd:string .

kv:valueContent a owl:DatatypeProperty ;
    rdfs:label "값 내용"@ko ;
    rdfs:domain kv:Value ;
    rdfs:range xsd:string .

kv:normalizedContent a owl:DatatypeProperty ;
    rdfs:label "정규화된 내용"@ko ;
    rdfs:domain kv:NormalizedValue ;
    rdfs:range xsd:string .

kv:source a owl:DatatypeProperty ;
    rdfs:label "출처"@ko ;
    rdfs:domain kv:Document ;
    rdfs:range xsd:string ;
    rdfs:comment "데이터 출처 (예: 병원데이터, 판례데이터)"@ko .

kv:timestamp a owl:DatatypeProperty ;
    rdfs:label "타임스탬프"@ko ;
    rdfs:domain kv:Document ;
    rdfs:range xsd:dateTime .
