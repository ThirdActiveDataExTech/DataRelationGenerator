@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dm:   <http://datarelation.wisenut.co.kr/ontology#> .

#######################################################################
# 데이터 관계 도메인 온톨로지 (의미 계층)
#
# 설계 원칙: "스키마는 사전 정의, 인스턴스는 자동 생성"
#   - 고정(사전 정의): 아래 클래스/속성 정의 + 최상위 도메인 시드.
#       → load_ontology.py 로 Neptune에 1회 적재한다.
#   - 가변(자동 생성): 데이터셋↔도메인 연결(belongsToDomain), 하위 개념,
#       데이터셋 간 관계는 적재 파이프라인이 런타임에 채운다.
#
# Neptune은 이 의미 계층(개념·데이터셋·관계)만 담당하며,
# 레코드 단위 Key-Value 인스턴스와 임베딩은 OpenSearch에 색인된다.
#######################################################################

<http://datarelation.wisenut.co.kr/ontology> a owl:Ontology ;
    rdfs:label   "데이터 관계 도메인 온톨로지"@ko ;
    rdfs:comment "써드파티 데이터셋을 현실의 도메인·개념에 매핑하는 액티브 메타데이터 의미 계층"@ko ;
    owl:versionInfo "2.0" .

#######################################################################
# 1. 클래스 (스키마 — 고정)
#######################################################################

dm:Domain a owl:Class ;
    rdfs:label   "도메인"@ko ;
    rdfs:comment "최상위 의미 영역 (예: 의료, 법률, 방송/콘텐츠)"@ko .

dm:Concept a owl:Class ;
    rdfs:label   "개념"@ko ;
    rdfs:comment "도메인 하위의 분류체계 개념 노드 (예: 병원, 진료과). 주로 LLM이 자동 생성한다."@ko .

dm:Dataset a owl:Class ;
    rdfs:label   "데이터셋"@ko ;
    rdfs:comment "사용자가 업로드한 표/파일 단위. 원본은 MinIO, 임베딩은 OpenSearch에 보관된다."@ko .

#######################################################################
# 2. Object Property (스키마 — 고정)
#######################################################################

dm:belongsToDomain a owl:ObjectProperty ;
    rdfs:label   "도메인 소속"@ko ;
    rdfs:domain  dm:Dataset ;
    rdfs:range   dm:Domain ;
    rdfs:comment "데이터셋이 속한 최상위 도메인. 적재 시 자동 연결된다."@ko .

dm:mapsToConcept a owl:ObjectProperty ;
    rdfs:label   "개념 매핑"@ko ;
    rdfs:domain  dm:Dataset ;
    rdfs:range   dm:Concept ;
    rdfs:comment "데이터셋이 나타내는 하위 개념. LLM 분류 결과로 채워진다."@ko .

dm:broaderConcept a owl:ObjectProperty ;
    rdfs:label   "상위 개념"@ko ;
    rdfs:subPropertyOf skos:broader ;
    rdfs:comment "개념 분류체계의 상위 관계 (예: 진료과 → 병원 → 의료)"@ko .

dm:hasSubConcept a owl:ObjectProperty ;
    rdfs:label   "하위 개념"@ko ;
    owl:inverseOf dm:broaderConcept .

dm:relatedDomain a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:label   "연관 도메인"@ko ;
    rdfs:domain  dm:Domain ;
    rdfs:range   dm:Domain ;
    rdfs:comment "거시 도메인 간 의미적 접점 (예: 의료 ↔ 법률: 의료법). 소수만 수동 정의한다."@ko .

dm:relatedTo a owl:ObjectProperty ;
    rdfs:label   "데이터셋 연관"@ko ;
    rdfs:comment "데이터셋 간 관계. rdf:Statement reification으로 score/method/relationType 메타데이터를 부착한다."@ko .

#######################################################################
# 3. Datatype Property (스키마 — 고정)
#######################################################################

dm:domainCode a owl:DatatypeProperty ;
    rdfs:label   "도메인 코드"@ko ;
    rdfs:domain  dm:Domain ;
    rdfs:range   xsd:string ;
    rdfs:comment "도메인 식별 코드 (예: medical, legal, broadcast)"@ko .

dm:tableName a owl:DatatypeProperty ;
    rdfs:label   "테이블명"@ko ;
    rdfs:domain  dm:Dataset ;
    rdfs:range   xsd:string .

dm:autoGenerated a owl:DatatypeProperty ;
    rdfs:label   "자동 생성 여부"@ko ;
    rdfs:range   xsd:boolean ;
    rdfs:comment "true=LLM/파이프라인 자동 생성, false=사전 정의 시드"@ko .

#######################################################################
# 4. 시드 인스턴스 (최상위 도메인 — 고정)
#    실증 도메인(연세의료원=의료, 판례=법률, SBSi=방송/콘텐츠) 기준.
#######################################################################

<http://datarelation.wisenut.co.kr/ontology#domain/medical> a dm:Domain ;
    rdfs:label "의료"@ko ;
    dm:domainCode "medical" ;
    dm:autoGenerated false .

<http://datarelation.wisenut.co.kr/ontology#domain/legal> a dm:Domain ;
    rdfs:label "법률"@ko ;
    dm:domainCode "legal" ;
    dm:autoGenerated false .

<http://datarelation.wisenut.co.kr/ontology#domain/broadcast> a dm:Domain ;
    rdfs:label "방송/콘텐츠"@ko ;
    dm:domainCode "broadcast" ;
    dm:autoGenerated false .

# 거시 도메인 간 관계 (소수 수동 정의 — 의료법 등 접점)
<http://datarelation.wisenut.co.kr/ontology#domain/medical>
    dm:relatedDomain <http://datarelation.wisenut.co.kr/ontology#domain/legal> .

#######################################################################
# 5. 예시 시드 개념 (의료 하위 — 고정, 나머지는 자동 확장)
#    "의료 ⊃ 병원 ⊃ 진료과" 분류체계의 출발점.
#######################################################################

<http://datarelation.wisenut.co.kr/ontology#concept/hospital> a dm:Concept ;
    rdfs:label "병원"@ko ;
    dm:broaderConcept <http://datarelation.wisenut.co.kr/ontology#domain/medical> ;
    dm:autoGenerated false .

<http://datarelation.wisenut.co.kr/ontology#concept/department> a dm:Concept ;
    rdfs:label "진료과"@ko ;
    dm:broaderConcept <http://datarelation.wisenut.co.kr/ontology#concept/hospital> ;
    dm:autoGenerated false .
