# Environment configuration
ENVIRONMENT=local
PORT=8000
SERVICE_NAME=Python FastAPI Template
SERVICE_CODE=100
MAJOR_VERSION=v1
STATUS=dev
STATIC_DIRECTORY=./static

# Server configuration
SERVER_URL=""

# Logging configuration
LEVEL=INFO
JSON_LOG=false
SAVE=true
LOG_SAVE_PATH=./logs
ROTATION=00:00
RETENTION=10 days
COMPRESSION=zip

# Backend CORS origins
BACKEND_CORS_ORIGINS=

# Service configuration
X_TOKEN=

# Database configuration
SQLITE_FILE_NAME=database.db