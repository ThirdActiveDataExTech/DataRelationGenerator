# Environment configuration
ENVIRONMENT=local
PORT=8000
SERVICE_NAME="3rd party"
SERVICE_CODE=100
MAJOR_VERSION=v1
STATUS=dev
STATIC_DIRECTORY=./static

# Server configuration
SERVER_URL=""

# Logging configuration
LEVEL=INFO
JSON_LOG=false
SAVE=true
LOG_SAVE_PATH=./logs
ROTATION=00:00
RETENTION="10 days"
COMPRESSION=zip

# Backend CORS origins
BACKEND_CORS_ORIGINS=

# Service configuration
X_TOKEN=wisenut

# Database configuration
SQLITE_FILE_NAME=database.db

# llm config
CLAUDE_MODEL_NAME=
CLAUDE_API_KEY=
LITE_LLM_BASE_URL=

# Langfuse Config
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=

# Neo4j Config
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
