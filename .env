# Environment configuration
ENVIRONMENT=local
PORT=8000
SERVICE_NAME="3rd party"
SERVICE_CODE=100
MAJOR_VERSION=v1
STATUS=dev
STATIC_DIRECTORY=./static

# Server configuration
SERVER_URL=""

# Logging configuration
LEVEL=INFO
JSON_LOG=false
SAVE=true
LOG_SAVE_PATH=./logs
ROTATION=00:00
RETENTION="10 days"
COMPRESSION=zip

# Backend CORS origins
BACKEND_CORS_ORIGINS=

# Service configuration
X_TOKEN=

# Database configuration
SQLITE_FILE_NAME=database.db

# llm config
CLAUDE_MODEL_NAME=
CLAUDE_API_KEY=
LITE_LLM_BASE_URL=

# Langfuse Config
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=

# Neo4j Config
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

NEO4J_TRANSPORT=
NEO4J_MCP_SERVER_HOST=
NEO4J_MCP_SERVER_PORT=
NEO4J_MCP_SERVER_PATH=
NEO4J_MCP_SERVER_ALLOWED_HOSTS=
NEO4J_MCP_SERVER_ALLOW_ORIGINS=

# Neptune Config
NEPTUNE_ENDPOINT=
NEPTUNE_REGION=
NEPTUNE_DIRECT_ENDPOINT=
NEPTUNE_USE_IAM=

# OpenSearch Config
OPENSEARCH_HOST=
OPENSEARCH_PORT=
OPENSEARCH_USE_SSL=
OPENSEARCH_VERIFY_CERTS=
OPENSEARCH_DOCUMENTS_INDEX=
OPENSEARCH_KEYS_INDEX=
OPENSEARCH_VALUES_INDEX=
OPENSEARCH_DATASETS_INDEX=third-party-datasets

# Embedding Config
EMBEDDING_MODEL_NAME=
SIMILARITY_THRESHOLD=
SIMILARITY_TOP_K=
